# Environment Variables for SAFE-Triage Mongo Track
# Note: AI calls go through Vertex AI Application Default Credentials (ADC).
# No API key is needed — authenticate via: gcloud auth application-default login
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/safe_triage?retryWrites=true&w=majority
# MDB_MCP_CONNECTION_STRING is used by the MongoDB MCP Server process (npx mongodb-mcp-server).
# If unset, falls back to MONGODB_URI automatically.
MDB_MCP_CONNECTION_STRING=
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=us-central1
MONGODB_DB_NAME=safe_triage
